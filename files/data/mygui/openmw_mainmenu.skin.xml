<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Resource" version="1.1">
    <!-- Gold title-menu lettering, independent of the brown in-game interface palette.
         Key focus stays visible without consuming the brighter mouse-hover state. -->
    <Resource type="ResourceSkin" name="MW_MainMenuTextButton" size="256 48">
        <Property key="FontName" value="Default"/>
        <Property key="TextAlign" value="Center"/>
        <Property key="NeedKey" value="true"/>
        <BasisSkin type="SimpleText" offset="0 0 256 48" align="Stretch">
            <State name="disabled" colour="0.55 0.47 0.30" shift="0"/>
            <State name="normal" colour="1 0.78 0.30" shift="0"/>
            <State name="focused" colour="1 0.85 0.46" shift="0"/>
            <State name="highlighted" colour="1 0.96 0.76" shift="0"/>
            <State name="pushed" colour="0.84 0.65 0.22" shift="1"/>
        </BasisSkin>
    </Resource>
</MyGUI>
